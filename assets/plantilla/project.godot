; Engine configuration for Godot {{GODOT_VERSION}}.

config_version=5

[application]

config/name="{{GAME_NAME}}"
config/version="0.0.1"
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("{{GODOT_MINOR}}", "{{FEATURE}}")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width={{VIEW_W}}
window/size/viewport_height={{VIEW_H}}
window/size/window_width_override={{WIN_W}}
window/size/window_height_override={{WIN_H}}
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation={{ORIENTATION}}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/fallback="es"

[rendering]

renderer/rendering_method="{{RENDERER}}"
textures/vram_compression/import_etc2_astc=true
